# Environment variables read by the project. The app reads the real process
# environment; it does not load this file automatically. In PowerShell use
# `$env:NAME = "value"`. Uncomment only the values you want to override.

# --- Paths and clock -------------------------------------------------------
# RUNS_DIR=results/runs                  # where batch runs are saved
# SCENARIOS_PATH=eval/scenarios.json     # frozen scenario definitions
# PROJECT_ROOT=                          # project root; default auto-detected
# DATABASE_PATH=var/mock_api.sqlite      # mock API SQLite file (regenerated by seed)
# SIMULATED_NOW=2026-11-10T10:00:00+05:00 # fixed demo clock; must include an offset

# --- Ollama model ----------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434     # local Ollama server URL
# MODEL=qwen2.5:3b                       # Ollama model tag
# TEMPERATURE=0                          # sampling temperature
# SEED=42                                # sampling seed
# NUM_CTX=4096                           # context window in tokens
# NUM_PREDICT=400                        # maximum generated tokens
# KEEP_ALIVE=30m                         # how long Ollama keeps the model loaded
# REQUEST_TIMEOUT_S=300                  # timeout for every Ollama call

# --- Mock API client -------------------------------------------------------
# MOCK_API_URL=                          # empty = call the mock API in-process
# MOCK_CLIENT_ID=lahore-heights          # demo client id for the token endpoint
# MOCK_CLIENT_SECRET=local-dev           # demo client secret (local only)
# ACCESS_TOKEN=lahore-heights-local-dev-token # bearer token the mock API accepts

# --- Retrieval and agent ---------------------------------------------------
# RAG_MODE=hybrid                        # dense | hybrid
# RAG_MODEL_NAME=BAAI/bge-small-en-v1.5  # sentence-transformers embedding model
# RAG_MANUAL_K=3                         # house-manual chunks used by basic RAG
# RAG_GUIDE_K=2                          # city-guide chunks used by basic RAG
# TOOL_SEARCH_K=4                        # results returned by the agent search tools
# MAX_TOOL_ROUNDS=4                      # tool rounds before the forced answer

# --- Demo UI and tests -----------------------------------------------------
# DEMO_MODE=live                         # live | replay (replay needs no Ollama)
# RUN_LLM=1                              # also run the Ollama tests (default: skipped)
